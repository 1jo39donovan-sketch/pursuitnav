# Settings for the house-number search (Nominatim), used by the nominatim
# service in docker-compose.yml and by scripts/build-geocoder.sh's import.
# Tuned for a 4 GB server that also runs Valhalla; see README.md for the
# measured memory and disk.

# The London extract build-map.sh downloads (mounted read-only at /osm).
PBF_PATH=/osm/region.osm.pbf
# Addresses down to house number, streets and places; no shops or other POIs
# (the app has its own place search). Smaller and quicker than "full".
IMPORT_STYLE=address
# GB postcode centroids, so postcodes OpenStreetMap lacks still resolve.
IMPORT_GB_POSTCODES=true
# Re-imported weekly, never updated in place: drop the update tables.
FREEZE=true
THREADS=2
GUNICORN_WORKERS=2

# PostgreSQL: the image's defaults assume a 32 GB machine.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_AUTOVACUUM_WORK_MEM=128MB
POSTGRES_WORK_MEM=16MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
