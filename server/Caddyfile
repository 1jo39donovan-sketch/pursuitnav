# HTTPS with an automatic certificate. Access logging is off (Caddy's
# default): requests carry officers' positions.
#
# With an email, Caddy can also get the certificate from ZeroSSL when Let's
# Encrypt refuses: Let's Encrypt allows only 5 certificates for one name a
# week, and on 21 Oct 2026 rebuilt servers used them all, leaving the server
# without HTTPS until the limit reset.
{
	email {$ACME_EMAIL}
}

# ALSO_SERVE (.env, optional): more names for the same server, space-separated,
# e.g. the old address while apps move to a new one. Each gets its own certificate.
{$DOMAIN} {$ALSO_SERVE} {
	encode gzip
	reverse_proxy api:3000
}
