{
  "expo": {
    "name": "Blue Route",
    "slug": "blue-route",
    "scheme": "blueroute",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1220",
    "ios": {
      "bundleIdentifier": "com.blueroute.patrol",
      "supportsTablet": false
    },
    "android": {
      "package": "com.blueroute.patrol",
      "adaptiveIcon": {
        "backgroundColor": "#0c1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Blue Route uses your location to show where you are and to work out routes and journey times from your current position.",
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
